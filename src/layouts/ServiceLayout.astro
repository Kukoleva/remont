---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  image?: string;
  jsonLd?: Array<Record<string, unknown>>;
}

const { title, description, h1, image, jsonLd = [] } = Astro.props;

const canonicalPage = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://vdomeremont.by/' },
    { '@type': 'ListItem', position: 2, name: h1, item: canonicalPage },
  ],
};
---

<BaseLayout title={title} description={description} image={image} jsonLd={[...jsonLd, breadcrumbJsonLd]}>
  <section class="border-b border-line bg-dark pt-16 text-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <nav aria-label="Хлебные крошки" class="mb-4 flex flex-wrap items-center gap-2 text-sm text-white/50">
        <a href="/" class="transition-colors hover:text-accent">Главная</a>
        <span aria-hidden="true">›</span>
        <span class="text-white/80">{h1}</span>
      </nav>
      <h1 class="font-display text-3xl font-bold leading-tight sm:text-5xl">{h1}</h1>
    </div>
  </section>
  <slot />
</BaseLayout>