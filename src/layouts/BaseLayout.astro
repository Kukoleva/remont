---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: Array<Record<string, unknown>>;
}

const { title, description, image, canonical, type, jsonLd = [] } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="google-site-verification" content="ks00vCIs8or5gbyv3gl-NpjoIAI2SruItR7eFGefKaI" />
    <meta name="yandex-verification" content="bfd2a56e50ffbe7a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      as="style"
      onload="this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" />
    </noscript>
    <SEO title={title} description={description} image={image} canonical={canonical} type={type} jsonLd={jsonLd} />
  </head>
  <body class="min-h-screen bg-bg font-body text-fg antialiased">
    <Header />
    <slot />
    <Footer />
  </body>
</html>