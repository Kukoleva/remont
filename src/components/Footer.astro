---
import { site } from '../data/site';
import { servicesNav } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-card pb-24 md:pb-0">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <a href="/" class="font-display text-lg font-bold">
          <span>Ремонт<span class="text-accent">Гомель</span></span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-muted">{site.role}</p>
      </div>

      <nav>
        <p class="mb-3 text-sm font-bold uppercase tracking-wider text-muted">Услуги</p>
        <ul class="space-y-2 text-sm">
          {servicesNav.map((s) => (
            <li><a href={s.href} class="text-muted transition-colors hover:text-accent">{s.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="text-sm">
        <p class="mb-3 font-bold uppercase tracking-wider text-muted">Контакты</p>
        <a href={site.contacts.phoneHref} class="block font-bold text-accent">{site.contacts.phone}</a>
        <a href={site.contacts.telegram} target="_blank" rel="noreferrer" class="mt-2 block text-muted transition-colors hover:text-accent">Telegram</a>
        <a href={site.contacts.whatsapp} target="_blank" rel="noreferrer" class="mt-1 block text-muted transition-colors hover:text-accent">WhatsApp</a>
        <a href={site.contacts.viber} target="_blank" rel="noreferrer" class="mt-1 block text-muted transition-colors hover:text-accent">Viber</a>
      </div>

      <div class="text-sm">
        <p class="mb-3 font-bold uppercase tracking-wider text-muted">Информация</p>
        <a href="/about/" class="block text-muted transition-colors hover:text-accent">О мастере</a>
        <a href="/blog/" class="mb-1 block text-muted transition-colors hover:text-accent">Блог</a>
        <a href="/contacts/" class="block text-muted transition-colors hover:text-accent">Контакты</a>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-6 text-sm text-muted">
      © {year} {site.brand} — {site.role}
    </div>
  </div>
</footer>