---
import Process from './sections/Process.astro';
import Reviews from './sections/Reviews.astro';
import FAQ from './sections/FAQ.astro';
import Gallery from './sections/Gallery.astro';
import CTA from './sections/CTA.astro';

interface Props {
  service: { label: string; intro: string };
  details: {
    includes: string[];
    priceTable: { name: string; unit: string; price: number }[];
    faq: { q: string; a: string }[];
    gallery: { title: string; alt: string; tag: string }[];
  };
  content?: (...args: unknown[]) => unknown;
}

const { service, details, content: Body } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
  <p class="max-w-3xl text-lg leading-relaxed text-muted">{service.intro}</p>
  {Body && (
    <div class="mt-8 max-w-3xl space-y-4 text-muted [&_h2]:mt-8 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-fg [&_p]:leading-relaxed">
      <Body />
    </div>
  )}
</section>

<!-- H2: Цены (таблица) -->
<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <h2 class="mb-8 text-center font-display text-3xl font-bold">Цены</h2>
  <div class="overflow-hidden rounded-2xl border border-line">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-line bg-card text-[11px] font-bold uppercase tracking-wider text-muted">
          <th class="px-5 py-3">Вид работ</th>
          <th class="px-5 py-3 text-right">Цена</th>
        </tr>
      </thead>
      <tbody>
        {details.priceTable.map((r) => (
          <tr class="border-b border-line/60 last:border-0">
            <td class="px-5 py-3 font-semibold">{r.name}</td>
            <td class="px-5 py-3 text-right font-display font-bold text-accent">
              {r.price} BYN <span class="text-xs font-normal text-muted">/{r.unit}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-xs text-muted">Цены ориентировочные. Точную смету посчитаю после бесплатного замера.</p>
</section>

<!-- H2: Что входит в услугу -->
<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <h2 class="mb-8 text-center font-display text-3xl font-bold">Что входит в услугу</h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    {details.includes.map((inc) => (
      <li class="flex items-start gap-3 rounded-2xl border border-line bg-card p-4">
        <span class="mt-0.5 text-accent">&#10003;</span>
        <span class="text-sm font-semibold">{inc}</span>
      </li>
    ))}
  </ul>
</section>

<Gallery items={details.gallery} title={`Наши проекты: ${service.label.toLowerCase()}`} />

<Process />
<Reviews />
<FAQ items={details.faq} />
<CTA />