---
import { site } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="reviews" class="border-y border-line bg-card">
  <div class="mx-auto max-w-7xl scroll-mt-20 px-4 py-20 sm:px-6">
    <SectionHeading tag="отзывы" title="Что говорят клиенты" />
    <div class="grid gap-5 md:grid-cols-3">
      {site.reviews.map((r) => (
        <blockquote class="rounded-2xl border border-line bg-bg p-7">
          <div class="text-lg text-accent">{'★'.repeat(r.stars)}</div>
          <p class="mt-4 text-sm leading-relaxed text-muted">«{r.text}»</p>
          <footer class="mt-5 text-sm font-extrabold">{r.name}</footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>