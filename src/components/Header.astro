---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.jpeg';
import { site } from '../data/site';
import { servicesNav } from '../data/navigation';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-bold">
      <Image src={heroImg} alt="Логотип РемонтГомель — ремонт квартир в Гомеле" width={28} height={28} class="rounded-md object-cover" />
      <span>Ремонт<span class="text-accent">Гомель</span></span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      <a href="/" class="text-sm font-semibold text-muted transition-colors hover:text-accent">Главная</a>
      <details class="relative">
        <summary class="cursor-pointer list-none text-sm font-semibold text-muted transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
          Услуги <span class="text-xs text-accent">▾</span>
        </summary>
        <div class="absolute left-0 top-full z-50 min-w-[240px] rounded-2xl border border-line bg-card p-2 shadow-2xl">
          {servicesNav.map((s) => (
            <a href={s.href} class="block rounded-xl px-4 py-2.5 text-sm font-semibold text-fg transition-colors hover:bg-accent-soft hover:text-accent">
              {s.label}
            </a>
          ))}
        </div>
      </details>
      <a href="/about/" class="text-sm font-semibold text-muted transition-colors hover:text-accent">О мастере</a>
      <a href="/blog/" class="text-sm font-semibold text-muted transition-colors hover:text-accent">Блог</a>
      <a href="/contacts/" class="text-sm font-semibold text-muted transition-colors hover:text-accent">Контакты</a>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={site.contacts.phoneHref} class="text-sm font-bold hover:text-accent">{site.contacts.phone}</a>
      <a
        href={site.contacts.whatsapp}
        target="_blank"
        rel="noreferrer"
        class="rounded-full bg-accent px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-accent/25 transition-colors hover:bg-accent-dark"
      >
        Замер бесплатно
      </a>
    </div>

    <details class="lg:hidden">
      <summary class="flex h-10 w-10 list-none cursor-pointer items-center justify-center rounded-xl border border-line text-lg [&::-webkit-details-marker]:hidden">
        ☰
      </summary>
      <nav class="absolute inset-x-0 top-16 border-t border-line bg-bg px-4 py-4 shadow-2xl">
        <a href="/" class="block border-b border-line/50 py-3 text-sm font-semibold">Главная</a>
        {servicesNav.map((s) => (
          <a href={s.href} class="block border-b border-line/50 py-3 text-sm font-semibold">{s.label}</a>
        ))}
        <a href="/about/" class="block border-b border-line/50 py-3 text-sm font-semibold">О мастере</a>
        <a href="/blog/" class="block border-b border-line/50 py-3 text-sm font-semibold">Блог</a>
        <a href="/contacts/" class="block border-b border-line/50 py-3 text-sm font-semibold">Контакты</a>
        <a href={site.contacts.phoneHref} class="block py-3 text-sm font-bold text-accent">{site.contacts.phone}</a>
      </nav>
    </details>
  </div>
</header>